FROM registry.astralinux.ru/library/astra/ubi18-golang121:1.8.5-mg16.2.0

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc=4:12.2.0-3+b1 \
    libc6-dev=2.36-9+deb12u7.astra10 \
    pkg-config=1.8.1-1+b1 \
    libgl1-mesa-dev=24.2.8-1.astra1+b10 \
    libx11-dev=2:1.8.7-1astra3+b3 \
    libxcursor-dev=1:1.2.1-1+b3 \
    libxrandr-dev=2:1.5.2-2+b2 \
    libxi-dev=2:1.8-1+b4 \
    libxinerama-dev=2:1.1.4-3+b3 \
    libxxf86vm-dev=1:1.1.4-1+b2 \
    libwayland-dev=1.23.0-1~bpo12+1+b3 \
    libxkbcommon-dev=1.7.0-1+b4 \
    wayland-protocols=1.39-1~bpo12+2 \
    && rm -rf /var/lib/apt/lists/*

# The base image has Go 1.21; go.mod requires a newer toolchain.
ENV GOTOOLCHAIN=auto CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    GOPATH=/tmp/go GOCACHE=/tmp/go-build
WORKDIR /src
ENTRYPOINT []
