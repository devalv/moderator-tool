FROM registry.red-soft.ru/ubi8/golang:1.26

USER root
RUN dnf install -y --setopt=install_weak_deps=False \
    gcc-13.3.1-3.red80.x86_64 \
    glibc-devel-2.36-14.red80.x86_64 \
    libX11-devel-1.8.9-1.red80.x86_64 \
    libXcursor-devel-1.2.0-7.red80.x86_64 \
    libXi-devel-1.7.10-8.red80.x86_64 \
    libXinerama-devel-1.1.4-10.red80.x86_64 \
    libXrandr-devel-1.5.2-8.red80.x86_64 \
    libXxf86vm-devel-1.1.4-18.red80.x86_64 \
    libxkbcommon-devel-1.8.1-1.red80.x86_64 \
    mesa-libGL-devel-24.3.4-4.red80.x86_64 \
    pkgconf-pkg-config-1.9.5-4.red80.x86_64 \
    wayland-devel-1.24.0-1.red80.x86_64 \
    wayland-protocols-devel-1.48-1.red80.noarch \
    && dnf clean all

ENV CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    GOPATH=/tmp/go GOCACHE=/tmp/go-build
WORKDIR /src
ENTRYPOINT []
