FROM registry.red-soft.ru/ubi8/golang:1.26

USER root
RUN dnf install -y --setopt=install_weak_deps=False \
    gcc glibc-devel pkgconf-pkg-config mesa-libGL-devel libX11-devel \
    libXcursor-devel libXrandr-devel libXi-devel libXinerama-devel libXxf86vm-devel \
    wayland-devel libxkbcommon-devel wayland-protocols-devel \
    && dnf clean all

ENV CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    GOPATH=/tmp/go GOCACHE=/tmp/go-build
WORKDIR /src
ENTRYPOINT []
